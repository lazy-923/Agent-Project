# DashScope / OpenAI-compatible chat model
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL_NAME=qwen3-max

# LlamaParse is only needed when parsed_documents.pkl does not exist.
LLAMA_PARSE_API_KEY=your_llama_parse_api_key

# Optional local paths
PDF_PATH=datas/From Mind to Machine The Rise of Manus AI as a Fully.pdf
PARSED_CACHE_PATH=parsed_documents.pkl

# Embedding settings
EMBED_MODEL_NAME=text-embedding-v4
RETRIEVER_TOP_K=3
